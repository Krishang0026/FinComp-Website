# Firebase Admin service-account JSON as a single TOML object.
[firebase_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
client_email = "firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

[firebase_web]
api_key = "Firebase Web API key"

[app]
# Random, long secret used only to encrypt the browser session cookie.
cookie_password = "replace-with-a-long-random-secret"
# Student IDs in this comma-separated list can operate the admin screen.
admin_student_ids = "PROF001"
