{
  "name": "trading-competition",
  "version": "1.0.0",
  "private": true,
  "description": "Live trading competition simulator, ready for Vercel.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "data:mock": "python scripts/generate_market_data.py --synthetic",
    "data:live": "python scripts/generate_market_data.py"
  },
  "dependencies": {
    "firebase-admin": "^13.0.1",
    "next": "^15.5.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
